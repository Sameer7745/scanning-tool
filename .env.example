# ==========================================================================
#  Scan Tool — bridge configuration
#  Copy this file to ".env" (same folder) and edit. Restart the bridge after.
# ==========================================================================

# How the bridge connects to the scanner:
#   usb      = USB scanner on this computer (via NAPS2). Nothing else needed.
#   wireless = network scanner over WiFi (eSCL). Set SCANNER_NAME/SCANNER_URL below.
#   auto     = wireless if SCANNER_NAME/SCANNER_URL is set, otherwise USB.
SCAN_MODE=usb

# --- Wireless settings (used ONLY when SCAN_MODE=wireless or auto) ----------
# Find the scanner by name — RECOMMENDED, because it survives IP changes:
# SCANNER_NAME=HP Smart Tank
#
# ...or pin a specific address (the bridge still auto-rediscovers if it moves):
# SCANNER_URL=http://192.168.1.36/eSCL
#
# If your scanner uses a non-standard eSCL port, set it here (default 80):
# SCANNER_PROBE_PORT=80
# ---------------------------------------------------------------------------

# Port the bridge listens on (the web UI calls http://localhost:<PORT>):
PORT=3001

# Text recognition (OCR). Off by default. Needs Tesseract installed to enable.
# OCR_ENABLED=1

# Troubleshooting:
# DEBUG=1
# LOG_FILE=/var/log/scan-tool.log
