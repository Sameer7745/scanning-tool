{
  "name": "scan-bridge-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local bridge server that drives a USB/TWAIN/SANE scanner and streams scanned pages to the browser.",
  "main": "index.js",
  "scripts": {
